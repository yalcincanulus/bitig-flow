{
  "name": "bitig-flow",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "infra:up": "docker compose up -d --wait postgres redis garage mailpit && docker compose run --rm garage-init",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait postgres redis garage mailpit && docker compose run --rm garage-init",
    "infra:logs": "docker compose logs -f",
    "infra:verify": "node --env-file=.env infra/verify.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "generate-routes": "tsr generate",
    "operator:bootstrap": "node --env-file=.env --import tsx src/server/operator-bootstrap-cli.ts",
    "operator:recover": "node --env-file=.env --import tsx src/server/operator-recover-cli.ts",
    "build": "vite build",
    "start": "srvx --prod --host 0.0.0.0 --dir . --entry dist/server/server.js -s dist/client",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "react-compiler:check": "mkdir -p .logs && node scripts/react-compiler-check.mjs 2>&1 | tee .logs/react-compiler.log",
    "test": "vitest run",
    "test:watch": "vitest",
    "sweep": "node --env-file=.env --import tsx src/server/sweep-cli.ts",
    "sweep:unconfirmed": "node --env-file=.env --import tsx src/server/sweep-cli.ts --unconfirmed",
    "sweep:orphans": "node --env-file=.env --import tsx src/server/sweep-cli.ts --orphans",
    "reaper": "node --env-file=.env --import tsx src/server/reaper-cli.ts",
    "reaper:watch": "node --env-file=.env --import tsx src/server/reaper-cli.ts --watch",
    "summary-fold": "node --env-file=.env --import tsx src/server/summary-fold-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "^0.18.0",
    "@tanstack/highlight": "^0.0.10",
    "@tanstack/markdown": "^0.0.13",
    "@tanstack/query-db-collection": "latest",
    "@tanstack/react-db": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "nodemailer": "^9.1.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "redis": "^6.2.1",
    "shadcn": "^4.21.0",
    "srvx": "^1.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.38",
    "@tanstack/router-core": "latest",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "fetch-cookie": "^3.2.0",
    "oxc-parser": "0.120.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "seroval": "^1.6.7",
    "tough-cookie": "^6.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
