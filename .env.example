# Copy to .env and fill in. Every value below has a working local default except
# the secrets, which you should generate yourself (commands noted inline).
#
# The infra values are read twice: by `docker compose` to configure the containers,
# and by the app to connect to them. Keep them in one place — do not duplicate.

# --- Postgres -----------------------------------------------------------------
# POSTGRES_* configure the container; DATABASE_URL is what the app connects with.
# They must agree.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bitig_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bitig_db

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=redis
REDIS_URL=redis://:redis@localhost:6379

# --- Garage (local S3) --------------------------------------------------------
# Single-node Garage stands in for object storage. Path-style endpoint, region is
# whatever `s3_region` says in infra/garage/garage.toml.
#
# WARNING: S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY are imported into Garage on
# first start and are then baked into the garage-meta volume. Changing the secret
# against an existing volume makes Garage refuse to start. To rotate, generate a
# new pair and `docker compose down -v` first.
#
#   S3_ACCESS_KEY_ID:     GK$(openssl rand -hex 16)   -- the GK prefix is required
#   S3_SECRET_ACCESS_KEY: openssl rand -hex 32
#   GARAGE_RPC_SECRET:    openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN:   openssl rand -base64 32
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=bitig
S3_ACCESS_KEY_ID=GK0000000000000000000000000000000
S3_SECRET_ACCESS_KEY=change-me
GARAGE_RPC_SECRET=change-me
GARAGE_ADMIN_TOKEN=change-me

# --- Email --------------------------------------------------------------------
# Development mail goes to Mailpit, which accepts any credentials and delivers
# nowhere. Web UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="bitig-flow <no-reply@bitig.local>"

# --- Auth ---------------------------------------------------------------------
#   BETTER_AUTH_SECRET: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Viewer / Gate ------------------------------------------------------------
#   ANALYTICS_SALT and GATE_RATELIMIT_SALT must be different. Generate each with:
#   openssl rand -hex 32
ANALYTICS_SALT=generate-a-salt
GATE_RATELIMIT_SALT=generate-a-different-salt
# Coolify/Traefik sits in front in production; 0 in local development uses the socket address.
TRUSTED_PROXY_COUNT=0
